    "@vueuse/core": "^14.4.0",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.1",
    "pako": "^3.0.1",
    "vue": "~3.5.40"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/node22": "^22.0.5",
    "@types/file-saver": "^2.0.7",
    "@types/node": "~26.1.2",
    "@vitejs/plugin-vue": "~6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "express": "~5.2.1",
    "oxfmt": "~0.61.0",
    "oxlint": "~1.76.0",
    "tailwindcss": "^4.3.2",
    "typescript": "~7.0.2",
    "vite": "^8.2.0",
    "vite-svg-loader": "^5.1.1",
    "vue-tsc": "~3.3.8"
  }
