{
  "name": "sonolus-studio",
  "version": "1.0.7",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "generate:tag-icons": "node scripts/generate-tag-icons.mjs",
    "check-type": "vue-tsc --build --force",
    "check-lint": "oxlint src",
    "check-format": "oxfmt --check index.html README.md vite.config.ts src",
    "check": "npm run check-lint && npm run check-format",
